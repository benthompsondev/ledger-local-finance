    "allow-forget-ai-key",
    "allow-ai-payload-preview",
    "allow-ai-coaching-summary",
    "allow-get-insight-feed",
    "allow-get-spending-patterns",
    "allow-explain-insight",
    "allow-get-net-worth-trend",
    "allow-save-net-worth-entry",
    "allow-delete-net-worth-entry",
    "allow-get-money-focus",
