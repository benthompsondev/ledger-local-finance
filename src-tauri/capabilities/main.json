{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Ledger's window can invoke only the narrow typed app commands below. The frontend receives no general shell, HTTP, filesystem, dialog, clipboard, process, URL opener, or window permissions — the native file picker runs entirely in Rust and returns only the user's explicit selection.",
