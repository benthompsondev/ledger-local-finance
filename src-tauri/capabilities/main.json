    "allow-confirm-import",
    "allow-reset-csv-profile",
    "allow-list-transactions",
    "allow-correct-transaction",
    "allow-undo-last-category-change",
    "allow-get-review-summary",
    "allow-get-shared-settings",
    "allow-save-shared-settings",
    "allow-set-shared-rule",
    "allow-get-category-settings",
    "allow-update-category-rule",
    "allow-delete-category-rule",
    "allow-set-recurring-preference",
    "allow-set-income-source-preference",
    "allow-add-manual-transaction",
    "allow-get-plan-summary",
    "allow-preview-plan",
    "allow-save-plan",
    "allow-get-goals-summary",
    "allow-create-goal",
    "allow-update-goal",
    "allow-contribute-goal",
    "allow-get-insights-summary",
    "allow-add-account-balance",
