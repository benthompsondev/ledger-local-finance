{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Northstar Ledger",
  "version": "2.9.0",
  "identifier": "dev.benthompson.ledger",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Northstar Ledger",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost https://github.com https://objects.githubusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Finance",
    "publisher": "Ben Thompson",
    "homepage": "https://github.com/benthompsondev/ledger-local-finance",
    "shortDescription": "Private, local financial clarity.",
    "longDescription": "Northstar Ledger is a private, local-first personal finance application. The native desktop app runs the existing deterministic Python finance engine as a packaged sidecar without opening a browser or exposing a localhost service.",
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "resources": {
      "../build/native-sidecar-dir/ledger-engine": "engine"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGRTY4NDQyODNGQjkyNApSV1FrdVQ4b1JHaitCV0NSOGZpS2tEcUMwZ3VMelNPbG1jODRYQ051YjJVU01ZbnVWcU4wWE5ZTgo=",
      "endpoints": [
        "https://github.com/benthompsondev/ledger-local-finance/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
